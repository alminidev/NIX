# ==============================================================================
# NIX 3D — VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env.local para desenvolvimento local:
#   cp .env.example .env.local
# ==============================================================================

# URL de destino para o botão de checkout / carrinho (InfinitePay ou checkout customizado)
# Usado pelos componentes Header, HeroStage, ProductCard e ProductGrid
NEXT_PUBLIC_CART_URL=https://checkout.infinitepay.io/nix3d

# PostgreSQL local. Suba com `npm run db:up` e copie a URL TCP que o Prisma imprimir.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/nix?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/nix?sslmode=disable"

# Better Auth
BETTER_AUTH_SECRET="gere-com-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
