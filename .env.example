# ==============================================================================
# NIX 3D — VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env.local para desenvolvimento local:
#   cp .env.example .env.local
# ==============================================================================

# URL pública do site. Monta o redirect depois do pagamento e, se for HTTPS, a URL do webhook.
# Em desenvolvimento: http://localhost:3000. Em produção: https://nix3d.com.br
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL local. Suba com `npm run db:up` (docker compose -f docker-compose.dev.yml).
DATABASE_URL="postgres://postgres:postgres@localhost:5432/nix?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:5432/nix_shadow?sslmode=disable"

# Pedidos aguardando pagamento expiram e devolvem o estoque após este tempo (minutos). Padrão: 60
ORDER_EXPIRATION_MINUTES=60

# Segredo da rota /api/orders/expire (cron). Enviado como "Authorization: Bearer <valor>".
# Gere com `openssl rand -base64 32`. Só no servidor; sem ele a rota recusa tudo.
CRON_SECRET="gere-com-openssl-rand-base64-32"

# Better Auth
BETTER_AUTH_SECRET="gere-com-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# Melhor Envio — só cotação de frete (a etiqueta não é comprada). Tudo fica no servidor.
# Token: painel do Melhor Envio, em Integrações. Nunca use o prefixo NEXT_PUBLIC_.
MELHOR_ENVIO_TOKEN="token-do-aplicativo"
# Sandbox: https://sandbox.melhorenvio.com.br  |  Produção: https://melhorenvio.com.br
MELHOR_ENVIO_BASE_URL="https://sandbox.melhorenvio.com.br"
# CEP de origem da loja, 8 dígitos.
MELHOR_ENVIO_FROM_POSTAL_CODE="00000000"
# User-Agent exigido pela API: nome do app e e-mail de contato. Se ficar vazio, usa "NIX (contato@nix3d.com.br)".
MELHOR_ENVIO_USER_AGENT="NIX (contato@nix3d.com.br)"

# InfinitePay — Checkout Integrado. Tudo fica no servidor; nunca use o prefixo NEXT_PUBLIC_.
# API Key: app InfinitePay > Vendas > Checkout > Configurações, com o Checkout Integrado habilitado.
# A chave aparece uma única vez (formato inchk_...).
INFINITEPAY_API_KEY="inchk_..."
# InfiniteTag sem o $.
INFINITEPAY_HANDLE="nix3d"
# Segredo nosso, não é da InfinitePay. Vai na URL do webhook e é conferido com comparação segura.
# Gere com `openssl rand -base64 32`. Sem ele o webhook recusa tudo; a confirmação real é o payment_check.
INFINITEPAY_WEBHOOK_SECRET="gere-com-openssl-rand-base64-32"
# Prefixo do order_nsu (ex.: nix-dev), para dev e produção não colidirem na mesma conta. Padrão: nix
INFINITEPAY_ORDER_PREFIX="nix"
